<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PsModelUI 7.6"
        ThemeMode="Light"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DemoDataTemplatesIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock"
                   BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
            </Style>

            <Style x:Key="NavigationButton"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="VerticalAlignment"
                        Value="Stretch" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Left" />
                <Setter Property="Margin"
                        Value="0,0,0,5" />
            </Style>

            <DataTemplate x:Key="GenericDemoCard">
                <Border Margin="0,0,0,16"
                        Padding="10"
                        Background="#BFFBFBFB"
                        CornerRadius="8"
                        UseLayoutRounding="True"
                        BorderThickness="1"
                        BorderBrush="#E5E5E5">
                    <StackPanel>
                        <TextBlock Text="{Binding Header, Mode=OneTime}"
                                   FontSize="14"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding BodyText, Mode=OneTime}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,10"
                                   Foreground="DimGray" />
                        <TextBlock Text="{Binding UpdatableContent}"
                                   FontSize="18"
                                   Margin="0,10" />
                        <Button Content="{Binding ButtonText, Mode=OneTime}"
                                Command="{Binding Command}"
                                HorizontalAlignment="Left"
                                Padding="15,5"
                                Margin="0,10,0,5" />
                        <TextBlock Text="{Binding FooterNote, Mode=OneTime}"
                                   FontSize="10"
                                   Foreground="DimGray" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ProgressBarDemoCard">
                <Border Margin="0,0,0,16"
                        Padding="10"
                        Background="#BFFBFBFB"
                        CornerRadius="8"
                        UseLayoutRounding="True"
                        BorderThickness="1"
                        BorderBrush="#E5E5E5">
                    <StackPanel>
                        <TextBlock Text="{Binding Header, Mode=OneTime}"
                                   FontSize="14"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding BodyText, Mode=OneTime}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,10"
                                   Foreground="DimGray" />
                        <TextBlock Text="{Binding UpdatableContent}"
                                   FontSize="18" />
                        <ProgressBar Value="{Binding StatusPercent}"
                                     Visibility="{Binding ProgressVisible}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="5"
                                     Margin="50,-20,50,0"
                                     DockPanel.Dock="Top" />
                        <Button Content="{Binding ButtonText, Mode=OneTime}"
                                Command="{Binding Command}"
                                HorizontalAlignment="Left"
                                Padding="15,5"
                                Margin="0,10,0,5" />
                        <Button Content="{Binding Status}"
                                Command="{Binding ProgressPauseCommand}"
                                Padding="10,5"
                                Margin="0,10,0,5"
                                HorizontalAlignment="Left"
                                DockPanel.Dock="Top" />
                        <TextBlock Text="{Binding FooterNote, Mode=OneTime}"
                                   FontSize="10"
                                   Foreground="DimGray" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="DataGridDemoCard">
                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Margin="0,0,0,16"
                        Padding="10"
                        Background="#BFFBFBFB"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="#E5E5E5">

                    <DockPanel Margin="20,20,20,0"
                               Grid.Column="1">
                        <TextBlock Text="{Binding Header, Mode=OneTime}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Top" />
                        <TextBlock Text="{Binding BodyText, Mode=OneTime}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,10"
                                   Foreground="DimGray"
                                   DockPanel.Dock="Top" />
                        <Button Content="{Binding ButtonText, Mode=OneTime}"
                                Command="{Binding Command}"
                                Padding="10,5"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                DockPanel.Dock="Top" />
                        <TextBlock Text="{Binding FooterNote, Mode=OneTime}"
                                   FontSize="10"
                                   Foreground="DimGray"
                                   DockPanel.Dock="Top" />
                        <DataGrid ItemsSource="{Binding GridContent}"
                                  ColumnWidth="*"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="True"
                                  DockPanel.Dock="Top"
                                  Margin="0,10,0,0">
                        </DataGrid>
                    </DockPanel>
                </Border>
            </DataTemplate>


            <DataTemplate DataType="{x:Type ViewModels:MainViewModel}">
                <Grid Margin="20,20,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="75" />
                        <RowDefinition Height="75" />
                        <RowDefinition Height="75" />
                        <RowDefinition Height="75" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".1*" />
                        <ColumnDefinition Width="*"
                                          MinWidth="100"
                                          MaxWidth="1000" />
                        <ColumnDefinition Width=".1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MainViewModel"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            CommandParameter="Demo"
                            Command="{Binding SwitchViewCommand}"
                            Style="{StaticResource NavigationButton}">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="Demo"
                                           FontSize="14" />
                                <TextBlock Text="Async buttons, throttled buttons, view models"
                                           Foreground="#5E6060" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Content="{Binding NavigationColor}"
                            Grid.Row="2"
                            Grid.Column="1"
                            CommandParameter="Color"
                            Command="{Binding SwitchViewCommand}"
                            Style="{StaticResource NavigationButton}">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="Color"
                                           FontSize="14" />
                                <TextBlock Text="Binding with textbox, slider without a converter"
                                           Foreground="#5E6060" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Content="{Binding NavigationXamlVisual}"
                            Grid.Row="3"
                            Grid.Column="1"
                            CommandParameter="Xaml Preview"
                            Command="{Binding SwitchViewCommand}"
                            Style="{StaticResource NavigationButton}">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock Text="Xaml Preview"
                                           FontSize="14" />
                                <TextBlock Text="An inefficient view of live xaml"
                                           Foreground="#5E6060" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type ViewModels:DemoViewModel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20,20,20,0"
                          Grid.Column="0"
                          UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="225" />
                            <RowDefinition Height="225" />
                            <RowDefinition Height="225" />
                            <RowDefinition Height="225" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width=".5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Header}"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <ContentControl Grid.Row="1"
                                        Content="{Binding LongTaskViewModel}"
                                        ContentTemplate="{DynamicResource GenericDemoCard}" />
                        <ContentControl Grid.Row="2"
                                        Content="{Binding SampleFunctionViewModel}"
                                        ContentTemplate="{DynamicResource GenericDemoCard}" />
                        <ContentControl Grid.Row="3"
                                        Content="{Binding DotSourcedViewModel}"
                                        ContentTemplate="{DynamicResource GenericDemoCard}" />
                        <ContentControl Grid.Row="1"
                                        Grid.RowSpan="3"
                                        Grid.Column="2"
                                        Content="{Binding AnotherTaskViewModel}"
                                        ContentTemplate="{DynamicResource DataGridDemoCard}" />
                        <ContentControl Grid.Row="4"
                                        Content="{Binding ProgressBarViewModel}"
                                        ContentTemplate="{DynamicResource ProgressBarDemoCard}" />
                    </Grid>
                </ScrollViewer>
            </DataTemplate>

            <DataTemplate DataType="{x:Type ViewModels:ColorViewModel}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="680" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".5*" />
                        <ColumnDefinition Width=".5*"
                                          MinWidth="600" />
                        <ColumnDefinition Width=".5*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Padding="10"
                            Background="{Binding ColorArgb}"
                            CornerRadius="8"
                            UseLayoutRounding="True"
                            BorderThickness="1"
                            BorderBrush="#E5E5E5">
                        <StackPanel>
                            <TextBlock Text="{Binding Header}"
                                       FontSize="14"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding Limitations}"
                                       FontSize="14"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HeaderAlpha}"
                                       Margin="0,20,0,0" />
                            <Slider Minimum="0"
                                    Maximum="255"
                                    Value="{Binding ElementName=ColorA, Path=Text}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    VerticalAlignment="Center" />
                            <TextBox Name="ColorA"
                                     Text="{Binding ColorA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding HeaderRed}"
                                       Margin="0,20,0,0" />
                            <Slider Minimum="0"
                                    Maximum="255"
                                    Value="{Binding ElementName=ColorR, Path=Text}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    VerticalAlignment="Center" />
                            <TextBox Name="ColorR"
                                     Text="{Binding ColorR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding HeaderGreen}"
                                       Margin="0,20,0,0" />
                            <Slider Minimum="0"
                                    Maximum="255"
                                    Value="{Binding ElementName=ColorG, Path=Text}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    VerticalAlignment="Center" />
                            <TextBox Name="ColorG"
                                     Text="{Binding ColorG, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding HeaderBlue}"
                                       Margin="0,20,0,0" />
                            <Slider Minimum="0"
                                    Maximum="255"
                                    Value="{Binding ElementName=ColorB, Path=Text}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    VerticalAlignment="Center" />
                            <TextBox Name="ColorB"
                                     Text="{Binding ColorB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding ColorArgbHexLabel}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Padding="10,8,0,0" />
                            <TextBox Text="{Binding ColorArgbText, Mode=TwoWay}"
                                     MaxLength="9" />
                        </StackPanel>
                    </Border>

                </Grid>
            </DataTemplate>

            <Style TargetType="{x:Type RadioButton}"
                   BasedOn="{StaticResource {x:Type RadioButton}}"
                   x:Key="MenuButton">
                <Style.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="MainBorder"
                                        CornerRadius="4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Margin="14,0,0,0">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="AccentBar"
                                                   Grid.Column="0"
                                                   Width="3"
                                                   Height="18"
                                                   Fill="#0078D4"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   HorizontalAlignment="Left"
                                                   Visibility="Collapsed"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="AccentScale"
                                                                ScaleY="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <ContentPresenter Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E3EDEF" />
                                    </Trigger>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E3EDEF" />
                                        <Setter TargetName="AccentBar"
                                                Property="Visibility"
                                                Value="Visible" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="AccentBar"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.0"
                                                                     Duration="0:0:0.50"
                                                                     BeginTime="0:0:0.0">
                                                        <DoubleAnimation.EasingFunction>
                                                            <ElasticEase Springiness="1"
                                                                         EasingMode="EaseOut"
                                                                         Oscillations="1" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>

                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <!-- Keep it visible DURING the exit animation -->
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AccentBar"
                                                                                   Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0"
                                                                                Value="{x:Static Visibility.Visible}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimation Storyboard.TargetName="AccentBar"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="0.0"
                                                                     Duration="0:0:0.15"
                                                                     BeginTime="0:0:0.0">
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E6EFF3" />
                                        <Setter Property="Foreground"
                                                Value="#777B7C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background"
                            Value="Transparent" />
                    <Setter Property="BorderThickness"
                            Value="0" />
                    <Setter Property="Height"
                            Value="35" />
                    <Setter Property="FontSize"
                            Value="14" />
                    <Setter Property="Margin"
                            Value="0,0,0,5" />
                </Style.Setters>
            </Style>

            <Style x:Key="SlideContentStyle"
                   TargetType="ContentControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid ClipToBounds="True">
                                <ContentPresenter x:Name="MainContent"
                                                  Content="{TemplateBinding Content}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="MainTransform" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MainTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             From="50"
                                                             To="0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <Trigger Property="Visibility"
                                         Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="MainTransform"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="50"
                                                                 To="0"
                                                                 Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <RadioButton CommandParameter="Home"
                         Command="{Binding SwitchViewCommand}"
                         IsChecked="True"
                         Style="{StaticResource MenuButton}"
                         GroupName="NavMenu">
                <RadioButton.Content>
                    <StackPanel Orientation="Horizontal"
                                Width="285">
                        <Image Source="{StaticResource HomeIcon}"
                               Width="24"
                               Height="24" />
                        <TextBlock Text="Home"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
            <RadioButton CommandParameter="Demo"
                         Command="{Binding SwitchViewCommand}"
                         Style="{StaticResource MenuButton}"
                         GroupName="NavMenu">
                <RadioButton.Content>
                    <StackPanel Orientation="Horizontal"
                                Width="285">
                        <Image Source="{StaticResource DesignIcon}"
                               Width="24"
                               Height="24" />
                        <TextBlock Text="Demo"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
            <RadioButton Command="{Binding SwitchViewCommand}"
                         CommandParameter="Color"
                         Style="{StaticResource MenuButton}"
                         GroupName="NavMenu">
                <RadioButton.Content>
                    <StackPanel Orientation="Horizontal"
                                Width="285">
                        <Image Source="{StaticResource PaletteIcon}"
                               Width="24"
                               Height="24" />
                        <TextBlock Text="Color"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
            <RadioButton Command="{Binding SwitchViewCommand}"
                         CommandParameter="Xaml Preview"
                         Style="{StaticResource MenuButton}"
                         GroupName="NavMenu">
                <RadioButton.Content>
                    <StackPanel Orientation="Horizontal"
                                Width="285">
                        <Image Source="{StaticResource CodeIcon}"
                               Width="24"
                               Height="24" />
                        <TextBlock Text="Xaml Preview"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
        </StackPanel>

        <TextBlock Text="{Binding Header}"
                   Grid.Row="0"
                   Grid.Column="1"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Margin="5,10,20,10" />

        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource SlideContentStyle}"
                        Content="{Binding CurrentViewModel, NotifyOnTargetUpdated=True}"
                        Visibility="{Binding ContentVisible}">
        </ContentControl>

        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource SlideContentStyle}"
                        Visibility="{Binding EditorVisible}">
            <Grid Margin="5,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        BorderThickness="1"
                        BorderBrush="#22000000" />
                <ScrollViewer Grid.Row="0"
                              Name="HotReload">
                    <TextBlock Text="Placeholder" />
                </ScrollViewer>
                <TextBox Text="{Binding XamlString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="14"
                         Margin="0,5,0,0" />
            </Grid>
        </ContentControl>

    </Grid>
</Window>
